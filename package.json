{
	"name": "sam-website",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"typegen": "sanity schemas extract --force --enforce-required-fields --path ./.sanity/schema.json && sanity typegen generate && ts-to-zod --config sanity-query-results && prettier --write ./src/lib/sanity/sanity.zod.ts",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo '' && husky",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"vitals": "svelte-vitals"
	},
	"devDependencies": {
		"@bbeetlesam/website-sanity-schema": "1.0.0",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-netlify": "^6.0.4",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.13.3",
		"eslint": "^10.9.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"husky": "^9.1.7",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"sanity": "^6.20.0",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"svelte-vitals": "^0.55.2",
		"tailwindcss": "^4.3.3",
		"ts-to-zod": "5.1.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.67.0",
		"vite": "^8.2.2"
	},
	"dependencies": {
		"@sanity/client": "^8.5.0",
		"groq": "^6.20.0",
		"roughjs": "^4.6.6",
		"zod": "^4.6.7"
	}
}
