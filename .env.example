# Sanity project ID used by the public client configuration.
PUBLIC_SANITY_PROJECT_ID=

# Sanity dataset name used by the public client configuration.
PUBLIC_SANITY_DATASET=

# Canonical production origin used to generate absolute canonical URLs.
# Set this to your stable production domain (for example, https://example.com).
# Leave blank locally to omit the canonical link during local development.
PUBLIC_SITE_URL=
